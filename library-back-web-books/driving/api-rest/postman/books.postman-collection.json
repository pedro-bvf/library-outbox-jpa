		{
			"name": "Not found error when getting a non-existing book",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonPayload = pm.response.json();",
							"",
							"const nonExistingId = pm.environment.get(\"nonExistingId\");",
							"",
							"pm.test(\"should have 404 status\", () => {",
							"    pm.response.to.have.status(404);",
							"});",
							"",
							"pm.test(\"should have the correct payload\", () => {",
							"",
							"    pm.expect(jsonPayload).to.have.property(\"error\");",
							"    pm.expect(jsonPayload.error).to.be.a(\"object\");",
							"",
							"    pm.expect(jsonPayload.error.code).to.eql(\"C01\");",
							"    pm.expect(jsonPayload.error.description).to.eql(`Book with id ${nonExistingId} not found.`);",
							"    pm.expect(jsonPayload.error.details[0]).to.eql(`Book with id ${nonExistingId} not found.`);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
