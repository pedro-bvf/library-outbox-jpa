	"item": [
		{
			"name": "Create a book",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonPayload = pm.response.json();",
							"const book = jsonPayload.data;",
							"",
							"postman.setEnvironmentVariable(\"id\", book.id);",
							"",
							"pm.test(\"should have 201 status\", () => {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"should have a JSON body\", () => {",
							"    pm.response.to.be.withBody;",
							"    pm.response.to.be.json;",
							"});",
							"",
							"pm.test(\"should have the created body\", () => {",
							"    pm.expect(book).to.have.property(\"id\");",
							"    pm.expect(book.publicId).to.eql(101);",
							"    pm.expect(book.title).to.eql(\"Fahrenheit 451\");",
							"    pm.expect(book.publisher.id).to.eql(pm.environment.get(\"publisherId\"));",
							"    pm.expect(book.authors).to.have.lengthOf(1);",
							"    pm.expect(book.authors[0].id).to.eql(pm.environment.get(\"authorId\"));",
							"    pm.expect(book.price).to.eql(15.5);",
							"    pm.expect(book.isDigital).to.eql(true);",
							"    pm.expect(book.isDeleted).to.eql(false);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}",
						"type": "text",
						"disabled": true
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"publicId\": 101,\n    \"title\": \"Fahrenheit 451\",\n    \"authors\": [\"{{authorId}}\"],\n    \"publisherId\": \"{{publisherId}}\",\n    \"coverUrl\": \"https://img/fahrenheit451.jpg\",\n    \"edition\": \"1st\",\n    \"price\": 15.5,\n    \"languages\": \"EN\",\n    \"epubUrl\": \"https://epub/fahrenheit451\",\n    \"isDigital\": true,\n    \"isDeleted\": false\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/books",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"books"
					]
				},
				"description": "This method creates a new book with the given body information. authorId and publisherId must reference existing records (see seed data in V1.0.1__insert-dataset-books.sql)."
			},
			"response": []
		},
		{
			"name": "Get a page of books",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonPayload = pm.response.json();",
							"const booksData = jsonPayload.data;",
							"",
							"pm.test(\"should have 200 status\", () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"should have a JSON body\", () => {",
							"    pm.response.to.be.withBody;",
							"    pm.response.to.be.json;",
							"});",
							"",
							"pm.test(\"should retrieve an array of books\", () => {",
							"    pm.expect(booksData).to.have.property(\"books\");",
							"    pm.expect(jsonPayload).to.have.property(\"pagination\");",
							"",
							"    const books = booksData.books;",
							"    pm.expect(books).to.be.a(\"array\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/books?firstPage=1&pageSize=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"books"
					],
					"query": [
						{
							"key": "firstPage",
							"value": "1"
						},
						{
							"key": "pageSize",
							"value": "10"
						}
					]
				},
				"description": "This method retrieves a paginated collection of books"
			},
			"response": []
		},
